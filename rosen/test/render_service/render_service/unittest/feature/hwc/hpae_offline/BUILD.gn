## Build RSHpaeOfflineDrawableTest
ohos_unittest("RSHpaeOfflineDrawableTest") {
  module_out_path = module_output_path
  sources = [ "rs_hpae_offline_drawable_test.cpp" ]
  deps = [
    ":rs_test_common",
    "$graphic_2d_root/rosen/modules/render_service/composer:librender_composer",
  ]
  include_dirs = [ "$graphic_2d_root/rosen/modules/render_service_base/include" ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "egl:libEGL",
    "opengles:libGLES",
    "libxml2:libxml2",
